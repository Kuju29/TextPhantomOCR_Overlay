{
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "scripting",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "processors/*.js",
        "processors/render/*.js",
        "shared/lens-document.js",
        "shared/ai-markers.js",
        "shared/ai-source-filter.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "support/chat.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "action": {
    "default_title": "TextPhantom",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  }
}
