{
  "manifest_version": 3,
  "name": "TextPhantom — แปลข้อความในภาพมังงะ มังฮวา",
  "version": "2026.9.26.4",
  "description": "🧠 Right-click any image → translate images",
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/compat.js",
        "shared/log-serialization.js",
        "content/namespace.js",
        "shared/diagnostic-schema.js",
        "shared/image-status-view.js",
        "content/trace.js",
        "content/image-scan-diagnostics.js",
        "content/keepalive.js",
        "content/dom-utils.js",
        "content/sites/alpha-manga/adapter.js",
        "content/sites/manga-mirai/adapter.js",
        "content/sites/kmanga/adapter.js",
        "content/progress-panel.js",
        "content/image-finder.js",
        "content/target-key.js",
        "content/image-status.js",
        "content/erase-canvas.js",
        "content/payload.js",
        "content/overlay/style.js",
        "content/overlay/background.js",
        "content/overlay/font-scale.js",
        "content/overlay/sanitize.js",
        "content/overlay/status.js",
        "content/overlay/mount.js",
        "content/overlay/local-render.js",
        "content/overlay.js",
        "content/overlay/message-controller.js",
        "content/image-buttons.js",
        "content/translate-all-button.js",
        "content/sites/mangadex/adapter.js",
        "content/sites/mangadex/collector.js",
        "content/mangadex.js",
        "content/sites/kagane/adapter.js",
        "content/reader/sources.js",
        "content/reader/classification.js",
        "content/reader/runtime.js",
        "content/messaging.js",
        "content/index.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/reader/page-sources.js",
        "content/sites/kagane/page-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "processors/*.js",
        "processors/render/*.js",
        "shared/lens-document.js",
        "shared/ai-markers.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
